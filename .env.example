# PSY LOOPER Environment Configuration

# Application
NODE_ENV=development
PORT=3000

# Audio
SAMPLE_RATE=48000
BUFFER_SIZE=2048
OVERSAMPLING=4

# MIDI
MIDI_ENABLED=true
MIDI_CLOCK_SYNC=true

# Performance
MAX_VOICES=64
MAX_FX_PER_SLICE=8
MAX_AUTOMATION_POINTS=1000

# Features
ENABLE_COPILOT=true
ENABLE_ML_CLASSIFICATION=true
ENABLE_LIVE_LOOPING=true

# Logging
LOG_LEVEL=info
ENABLE_PERFORMANCE_LOGS=false

# Export
EXPORT_FORMAT=wav
EXPORT_BIT_DEPTH=24
EXPORT_SAMPLE_RATE=48000
