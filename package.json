{
  "name": "psy-looper",
  "version": "1.1.0",
  "description": "Advanced Loop Manipulator - Most advanced looper in PSY family",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "bunx serve .",
    "build": "bun run scripts/build.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "bunx @biomejs/biome@1.9.4 check .",
    "lint:fix": "bunx @biomejs/biome@1.9.4 check --write .",
    "format": "bunx @biomejs/biome@1.9.4 format --write .",
    "verify": "bun test && bunx @biomejs/biome@1.9.4 check . && bun scripts/coverage-floor.mjs",
    "e2e": "bun scripts/e2e-pipeline.mjs",
    "coverage:floor": "bun scripts/coverage-floor.mjs"
  },
  "keywords": [
    "looper",
    "slicer",
    "audio",
    "dsp",
    "web-audio",
    "psytrance",
    "music-production",
    "pwa"
  ],
  "author": "dudududi144-source",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0",
    "@biomejs/biome": "^1.9.4"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dudududi144-source/psysampler"
  }
}
